# Local development defaults. Production values live in the host's env config.
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-secret-change-in-production"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# AI providers (server-side only — never expose to the client). Optional:
# without them, the deterministic fallback engine handles classification,
# priority and drafts. Per-task variables override the shared ones.
# Reference configuration (chosen by a measured bake-off, see README):
#   classification -> gpt-4o-mini, drafts -> claude-haiku-4.5,
#   both via one OpenAI-compatible route.
AI_API_KEY=""
AI_BASE_URL=""
AI_CLASSIFY_MODEL="openai/gpt-4o-mini"
AI_DRAFT_MODEL="anthropic/claude-haiku-4.5"
