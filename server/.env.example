# Local development defaults. Production values live in the host's env config.
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-secret-change-in-production"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# AI provider (server-side only — never expose to the client). Optional:
# without it, the deterministic fallback engine handles classification,
# priority and drafts.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
